
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30,
      "excludeFiles": "{.env*,images/**,tests/**,scripts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/send-mail.php",
      "destination": "/api/send-mail.php"
    }
  ]
}
